{
  "name": "@devteam-sdg/wjs-client",
  "version": "1.0.3",
  "description": "TypeScript SDK for the Wishlist JS API",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevTeamApps/wjs-client.git",
    "directory": "packages/client"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --root ../..",
    "test:watch": "vitest --root ../..",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
